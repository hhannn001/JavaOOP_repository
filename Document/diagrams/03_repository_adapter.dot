digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.6, dpi=110];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#627086"];
UserRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>UserRepository</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+findByLoginId(loginId) Optional&lt;UserAccount&gt;</TD></TR></TABLE>>];
MapRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>MapRepository</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+findAll() List&lt;GameMap&gt;</TD></TR><TR><TD ALIGN="LEFT">+findById(mapId) Optional&lt;GameMap&gt;</TD></TR></TABLE>>];
PuzzleRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>PuzzleRepository</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+findByMapId(mapId) List&lt;Puzzle&gt;</TD></TR></TABLE>>];
ClearRecordRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>ClearRecordRepository</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+findByUserId(userId) List&lt;ClearRecord&gt;</TD></TR><TR><TD ALIGN="LEFT">+saveBest(record)</TD></TR></TABLE>>];
JdbcUserRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>JdbcUserRepository</B></TD></TR></TABLE>>];
JdbcMapRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>JdbcMapRepository</B></TD></TR></TABLE>>];
JdbcPuzzleRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>JdbcPuzzleRepository</B></TD></TR></TABLE>>];
JdbcClearRecordRepository [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>JdbcClearRecordRepository</B></TD></TR></TABLE>>];
Database [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Database</B></TD></TR><TR><TD ALIGN="LEFT">+open() Connection</TD></TR><TR><TD ALIGN="LEFT">+initialize()</TD></TR></TABLE>>];
LoginService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>LoginService</B></TD></TR></TABLE>>];
MapCatalogService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>MapCatalogService</B></TD></TR></TABLE>>];
GameFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameFacade</B></TD></TR></TABLE>>];
DashboardRecords [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>DashboardRecords</B></TD></TR><TR><TD ALIGN="LEFT">+rooms()</TD></TR><TR><TD ALIGN="LEFT">+ranking(roomId, loginId)</TD></TR><TR><TD ALIGN="LEFT">+progress(loginId)</TD></TR></TABLE>>];
JdbcUserRepository -> UserRepository [style=dashed, arrowhead=empty];
JdbcMapRepository -> MapRepository [style=dashed, arrowhead=empty];
JdbcPuzzleRepository -> PuzzleRepository [style=dashed, arrowhead=empty];
JdbcClearRecordRepository -> ClearRecordRepository [style=dashed, arrowhead=empty];
JdbcUserRepository -> Database [arrowhead=vee];
JdbcMapRepository -> Database [arrowhead=vee];
JdbcPuzzleRepository -> Database [arrowhead=vee];
JdbcClearRecordRepository -> Database [arrowhead=vee];
LoginService -> UserRepository [arrowhead=vee];
MapCatalogService -> MapRepository [arrowhead=vee];
MapCatalogService -> ClearRecordRepository [arrowhead=vee];
GameFacade -> MapRepository [arrowhead=vee];
GameFacade -> PuzzleRepository [arrowhead=vee];
GameFacade -> ClearRecordRepository [arrowhead=vee];
DashboardRecords -> Database [arrowhead=vee, label="read-only JDBC"];
}
