digraph ERD {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.8, ranksep=1.4, dpi=180, splines=polyline, fontname="Helvetica", fontsize=24, labelloc=t, label="CODE ROOM  |  ERD\n "];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=12, color="#52657b", fontcolor="#52657b", arrowsize=0.9];
users [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#8c9eb3"><TR><TD COLSPAN="3" BGCOLOR="#dfeaf5" ALIGN="LEFT"><B>users</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">login_id</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">UNIQUE</FONT></TD></TR><TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f3f6fa"><FONT POINT-SIZE="11">UNIQUE (login_id)</FONT></TD></TR></TABLE>>];
maps [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#8c9eb3"><TR><TD COLSPAN="3" BGCOLOR="#dfeaf5" ALIGN="LEFT"><B>maps</B></TD></TR><TR><TD ALIGN="LEFT">map_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">topic</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">difficulty</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">poster_path</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">playable</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">0 / 1</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f3f6fa"><FONT POINT-SIZE="11">playable IN (0, 1)</FONT></TD></TR></TABLE>>];
puzzles [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#8c9eb3"><TR><TD COLSPAN="3" BGCOLOR="#dfeaf5" ALIGN="LEFT"><B>puzzles</B></TD></TR><TR><TD ALIGN="LEFT">puzzle_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">PK</FONT></TD></TR><TR><TD ALIGN="LEFT">map_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">FK</FONT></TD></TR><TR><TD ALIGN="LEFT">step_no</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">code</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">answer_type</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">DIGITS4 / GRID3X3</FONT></TD></TR><TR><TD ALIGN="LEFT">answer</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD ALIGN="LEFT">hint</TD><TD ALIGN="LEFT">TEXT</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c"> </FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f3f6fa"><FONT POINT-SIZE="11">UNIQUE (map_id, step_no)</FONT></TD></TR></TABLE>>];
clear_records [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="10" COLOR="#8c9eb3"><TR><TD COLSPAN="3" BGCOLOR="#dfeaf5" ALIGN="LEFT"><B>clear_records</B></TD></TR><TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">map_id</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT">best_seconds</TD><TD ALIGN="LEFT">INTEGER</TD><TD ALIGN="LEFT"><FONT COLOR="#51647c">&gt;= 0</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BGCOLOR="#f3f6fa"><FONT POINT-SIZE="11">PRIMARY KEY (user_id, map_id)</FONT></TD></TR></TABLE>>];
users -> clear_records [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" user_id ", taillabel="1", headlabel="0..*", labeldistance=2];
maps -> clear_records [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" map_id ", taillabel="1", headlabel="0..*", labeldistance=2];
maps -> puzzles [dir=both, arrowtail=teetee, arrowhead=crowodot, label=" map_id ", taillabel="1", headlabel="0..*", labeldistance=2];
{rank=same; users; maps;}
{rank=same; clear_records; puzzles;}
}