digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.6, dpi=110];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#627086"];
GameFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameFacade</B></TD></TR><TR><TD ALIGN="LEFT">-GameSession session</TD></TR><TR><TD ALIGN="LEFT">-GameSetup setup</TD></TR><TR><TD ALIGN="LEFT">+submit(objectId, answer) SubmitResult</TD></TR><TR><TD ALIGN="LEFT">+selectItem(itemId) GameView</TD></TR><TR><TD ALIGN="LEFT">+useKey(nowNanos) EscapeResult</TD></TR></TABLE>>];
GameSession [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameSession</B></TD></TR><TR><TD ALIGN="LEFT">-long userId</TD></TR><TR><TD ALIGN="LEFT">-long mapId</TD></TR><TR><TD ALIGN="LEFT">-GameStage stage</TD></TR><TR><TD ALIGN="LEFT">-ItemId selectedItem</TD></TR><TR><TD ALIGN="LEFT">-long startedAtNanos</TD></TR><TR><TD ALIGN="LEFT">-Long clearedSeconds</TD></TR><TR><TD ALIGN="LEFT">+inventory() List&lt;ItemId&gt;</TD></TR><TR><TD ALIGN="LEFT">+select(itemId)</TD></TR><TR><TD ALIGN="LEFT">+unlockDrawer()</TD></TR><TR><TD ALIGN="LEFT">+unlockSafe()</TD></TR><TR><TD ALIGN="LEFT">+escape(nowNanos)</TD></TR></TABLE>>];
Puzzle [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Puzzle</B></TD></TR><TR><TD ALIGN="LEFT">-long puzzleId</TD></TR><TR><TD ALIGN="LEFT">-long mapId</TD></TR><TR><TD ALIGN="LEFT">-int stepNo</TD></TR><TR><TD ALIGN="LEFT">-String code</TD></TR><TR><TD ALIGN="LEFT">-AnswerType answerType</TD></TR><TR><TD ALIGN="LEFT">-String answer</TD></TR><TR><TD ALIGN="LEFT">-String hint</TD></TR><TR><TD ALIGN="LEFT">+check(rawAnswer) AnswerCheck</TD></TR></TABLE>>];
GameSetup [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameSetup</B></TD></TR><TR><TD ALIGN="LEFT">+map() GameMap</TD></TR><TR><TD ALIGN="LEFT">+puzzles() List&lt;Puzzle&gt;</TD></TR></TABLE>>];
GameMap [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameMap</B></TD></TR><TR><TD ALIGN="LEFT">+getMapId() int</TD></TR><TR><TD ALIGN="LEFT">+isPlayable() boolean</TD></TR><TR><TD ALIGN="LEFT">+getHintLimit() int</TD></TR></TABLE>>];
GameView [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameView</B></TD></TR><TR><TD ALIGN="LEFT">+stage() GameStage</TD></TR><TR><TD ALIGN="LEFT">+items() List&lt;ItemView&gt;</TD></TR><TR><TD ALIGN="LEFT">+selectedItem() ItemId</TD></TR><TR><TD ALIGN="LEFT">+elapsedSeconds() long</TD></TR></TABLE>>];
ItemView [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>ItemView</B></TD></TR><TR><TD ALIGN="LEFT">+id() ItemId</TD></TR><TR><TD ALIGN="LEFT">+title() String</TD></TR><TR><TD ALIGN="LEFT">+content() String</TD></TR><TR><TD ALIGN="LEFT">+hint() String</TD></TR></TABLE>>];
GameStage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameStage</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;enumeration&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">START</TD></TR><TR><TD ALIGN="LEFT">DRAWER_OPEN</TD></TR><TR><TD ALIGN="LEFT">SAFE_OPEN</TD></TR><TR><TD ALIGN="LEFT">ESCAPED</TD></TR></TABLE>>];
ItemId [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>ItemId</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;enumeration&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">NOTE1</TD></TR><TR><TD ALIGN="LEFT">NOTE2</TD></TR><TR><TD ALIGN="LEFT">KEY</TD></TR></TABLE>>];
ClearRecord [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>ClearRecord</B></TD></TR><TR><TD ALIGN="LEFT">+getUserId() long</TD></TR><TR><TD ALIGN="LEFT">+getMapId() long</TD></TR><TR><TD ALIGN="LEFT">+getBestSeconds() long</TD></TR></TABLE>>];
GameFacade -> GameSession [dir=both, arrowtail=diamond, arrowhead=none];
GameFacade -> GameSetup [arrowhead=vee];
GameSetup -> Puzzle [arrowhead=vee];
GameSession -> GameStage [arrowhead=vee];
GameSession -> ItemId [arrowhead=vee];
GameFacade -> Puzzle [style=dashed, arrowhead=vee, label="validates answer"];
GameFacade -> GameView [style=dashed, arrowhead=vee, label="returns snapshot"];
GameView -> ItemView [dir=both, arrowtail=odiamond, arrowhead=none];
GameFacade -> ClearRecord [style=dashed, arrowhead=vee, label="creates on escape"];
GameSetup -> GameMap [arrowhead=vee];
}
