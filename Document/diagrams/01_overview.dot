digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.35, ranksep=0.6, dpi=110];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#627086"];
Main [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Main</B></TD></TR></TABLE>>];
MainFrame [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>MainFrame</B></TD></TR></TABLE>>];
AppController [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>AppController</B></TD></TR></TABLE>>];
Host [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Host</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+setPage(name, page)</TD></TR><TR><TD ALIGN="LEFT">+showPage(name)</TD></TR></TABLE>>];
Screens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Screens</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR><TR><TD ALIGN="LEFT">+login(onLogin)</TD></TR><TR><TD ALIGN="LEFT">+dashboard(user, openMaps, logout)</TD></TR><TR><TD ALIGN="LEFT">+maps(user, openMap, dashboard)</TD></TR><TR><TD ALIGN="LEFT">+game(user, mapId, back, restart)</TD></TR></TABLE>>];
AppScreens [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>AppScreens</B></TD></TR></TABLE>>];
DashboardPage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>DashboardPage</B></TD></TR></TABLE>>];
DashboardRecordDialog [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>DashboardRecordDialog</B></TD></TR></TABLE>>];
DashboardRecords [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>DashboardRecords</B></TD></TR></TABLE>>];
LoginPage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>LoginPage</B></TD></TR></TABLE>>];
LoginService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>LoginService</B></TD></TR></TABLE>>];
MapSelectionPage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>MapSelectionPage</B></TD></TR></TABLE>>];
MapCatalogService [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>MapCatalogService</B></TD></TR></TABLE>>];
GamePage [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GamePage</B></TD></TR><TR><TD ALIGN="LEFT">+load(user, mapId)</TD></TR><TR><TD ALIGN="LEFT">+inspect(object)</TD></TR><TR><TD ALIGN="LEFT">+submit(object, answer)</TD></TR><TR><TD ALIGN="LEFT">+selectItem(item)</TD></TR><TR><TD ALIGN="LEFT">+useKey()</TD></TR><TR><TD ALIGN="LEFT">+retrySave()</TD></TR><TR><TD ALIGN="LEFT">+disposeGame()</TD></TR></TABLE>>];
GamePort [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GamePort</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR></TABLE>>];
Widgets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>Widgets</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interface&gt;&gt;</TD></TR></TABLE>>];
GameAdapter [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameAdapter</B></TD></TR></TABLE>>];
GameWidgets [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameWidgets</B></TD></TR></TABLE>>];
GameFacade [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>GameFacade</B></TD></TR></TABLE>>];
RoomPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>RoomPanel</B></TD></TR></TABLE>>];
InventoryPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>InventoryPanel</B></TD></TR></TABLE>>];
CluePanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>CluePanel</B></TD></TR></TABLE>>];
AnswerInputPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>AnswerInputPanel</B></TD></TR></TABLE>>];
ResultPanel [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BGCOLOR="#dde7f5"><B>ResultPanel</B></TD></TR></TABLE>>];
Main -> MainFrame [style=dashed, arrowhead=vee, label="creates"];
Main -> AppController [style=dashed, arrowhead=vee, label="creates"];
Main -> AppScreens [style=dashed, arrowhead=vee, label="wires services"];
MainFrame -> Host [style=dashed, arrowhead=empty];
AppScreens -> Screens [style=dashed, arrowhead=empty];
AppController -> Host [arrowhead=vee];
AppController -> Screens [arrowhead=vee];
AppController -> GamePage [arrowhead=vee, label="lifecycle"];
AppScreens -> DashboardPage [style=dashed, arrowhead=vee, label="creates"];
AppScreens -> LoginPage [style=dashed, arrowhead=vee, label="creates"];
AppScreens -> MapSelectionPage [style=dashed, arrowhead=vee, label="creates"];
AppScreens -> GamePage [style=dashed, arrowhead=vee, label="creates"];
AppScreens -> GameAdapter [style=dashed, arrowhead=vee, label="nested adapter"];
AppScreens -> GameWidgets [style=dashed, arrowhead=vee, label="nested adapter"];
DashboardPage -> DashboardRecordDialog [style=dashed, arrowhead=vee, label="opens"];
DashboardRecordDialog -> DashboardRecords [arrowhead=vee];
LoginPage -> LoginService [arrowhead=vee];
MapSelectionPage -> MapCatalogService [arrowhead=vee];
GamePage -> GamePort [arrowhead=vee];
GamePage -> Widgets [arrowhead=vee];
GameAdapter -> GamePort [style=dashed, arrowhead=empty];
GameAdapter -> GameFacade [arrowhead=vee];
GameWidgets -> Widgets [style=dashed, arrowhead=empty];
GameWidgets -> RoomPanel [dir=both, arrowtail=diamond, arrowhead=none];
GameWidgets -> InventoryPanel [dir=both, arrowtail=diamond, arrowhead=none];
GameWidgets -> CluePanel [dir=both, arrowtail=diamond, arrowhead=none];
GameWidgets -> AnswerInputPanel [dir=both, arrowtail=diamond, arrowhead=none];
GameWidgets -> ResultPanel [dir=both, arrowtail=diamond, arrowhead=none];
}
