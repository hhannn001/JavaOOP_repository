digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.45", nodesep="0.45", ranksep="0.75", dpi=160, splines=polyline, fontname="Helvetica", fontsize=24, labelloc=t, labeljust=l, label="01  |  CODE ROOM — Application structure\n "];
node [shape=plain, fontname="Helvetica"];
edge [fontname="Helvetica", fontsize=10, color="#627086", fontcolor="#46546a", arrowsize=0.8];
Main [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#dde7f5"><FONT POINT-SIZE="10" COLOR="#536075">app</FONT><BR ALIGN="LEFT"/><B>Main</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+main(args)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
MainFrame [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#dde7f5"><FONT POINT-SIZE="10" COLOR="#536075">app</FONT><BR ALIGN="LEFT"/><B>MainFrame</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">-CardLayout layout<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+showPage(name)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
AppController [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#dde7f5"><FONT POINT-SIZE="10" COLOR="#536075">app</FONT><BR ALIGN="LEFT"/><B>AppController</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">-LoginUser currentUser<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+onLogin(user)<BR ALIGN="LEFT"/>+openMap(mapId)<BR ALIGN="LEFT"/>+backToMaps()<BR ALIGN="LEFT"/>+logout()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
LoginPage [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#def0ed"><FONT POINT-SIZE="10" COLOR="#536075">pages</FONT><BR ALIGN="LEFT"/><B>LoginPage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+showError(message)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
LoginService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#e8e1f6"><FONT POINT-SIZE="10" COLOR="#536075">features</FONT><BR ALIGN="LEFT"/><B>LoginService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+login(loginId, password) LoginResult<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
MapSelectionPage [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#def0ed"><FONT POINT-SIZE="10" COLOR="#536075">pages</FONT><BR ALIGN="LEFT"/><B>MapSelectionPage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+render(cards)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
MapCatalogService [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#e8e1f6"><FONT POINT-SIZE="10" COLOR="#536075">features</FONT><BR ALIGN="LEFT"/><B>MapCatalogService</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+listForUser(userId) List&lt;MapCard&gt;<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
GamePage [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#def0ed"><FONT POINT-SIZE="10" COLOR="#536075">pages</FONT><BR ALIGN="LEFT"/><B>GamePage</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+render(view)<BR ALIGN="LEFT"/>+disposeGame()<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
GameFacade [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#e8e1f6"><FONT POINT-SIZE="10" COLOR="#536075">features</FONT><BR ALIGN="LEFT"/><B>GameFacade</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT"><FONT POINT-SIZE="11">+loadMap(mapId) GameSetup<BR ALIGN="LEFT"/>+start(userId, setup, nowNanos) GameView<BR ALIGN="LEFT"/>+inspect(objectId) InspectResult<BR ALIGN="LEFT"/>+submit(objectId, answer) SubmitResult<BR ALIGN="LEFT"/>+selectItem(itemId) GameView<BR ALIGN="LEFT"/>+useKey(nowNanos) EscapeResult<BR ALIGN="LEFT"/>+saveClear(record)<BR ALIGN="LEFT"/>+view(nowNanos) GameView<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
RoomPanel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#fff0d7"><FONT POINT-SIZE="10" COLOR="#536075">widgets</FONT><BR ALIGN="LEFT"/><B>RoomPanel</B></TD></TR></TABLE>>];
InventoryPanel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#fff0d7"><FONT POINT-SIZE="10" COLOR="#536075">widgets</FONT><BR ALIGN="LEFT"/><B>InventoryPanel</B></TD></TR></TABLE>>];
CluePanel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#fff0d7"><FONT POINT-SIZE="10" COLOR="#536075">widgets</FONT><BR ALIGN="LEFT"/><B>CluePanel</B></TD></TR></TABLE>>];
AnswerInputPanel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#e8e1f6"><FONT POINT-SIZE="10" COLOR="#536075">features</FONT><BR ALIGN="LEFT"/><B>AnswerInputPanel</B></TD></TR></TABLE>>];
ResultPanel [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9" COLOR="#8896a9"><TR><TD ALIGN="LEFT" BGCOLOR="#fff0d7"><FONT POINT-SIZE="10" COLOR="#536075">widgets</FONT><BR ALIGN="LEFT"/><B>ResultPanel</B></TD></TR></TABLE>>];
Main -> AppController [style=dashed, arrowhead=vee, label="constructor wiring"];
Main -> MainFrame [style=dashed, arrowhead=vee];
AppController -> MainFrame [arrowhead=vee];
AppController -> LoginPage [arrowhead=vee];
AppController -> MapSelectionPage [arrowhead=vee];
AppController -> GamePage [arrowhead=vee];
LoginPage -> LoginService [arrowhead=vee];
MapSelectionPage -> MapCatalogService [arrowhead=vee];
GamePage -> GameFacade [arrowhead=vee];
GamePage -> RoomPanel [dir=both, arrowtail=diamond, arrowhead=none];
GamePage -> InventoryPanel [dir=both, arrowtail=diamond, arrowhead=none];
GamePage -> CluePanel [dir=both, arrowtail=diamond, arrowhead=none];
GamePage -> AnswerInputPanel [dir=both, arrowtail=diamond, arrowhead=none];
GamePage -> ResultPanel [dir=both, arrowtail=diamond, arrowhead=none];
{rank=same; LoginPage; MapSelectionPage; GamePage;}
legend [shape=plain, label=<<FONT POINT-SIZE="10" COLOR="#627086">+ public   /   - private     |     dashed arrow: dependency     |     solid arrow: reference<BR/>filled diamond: composition     |     hollow diamond: aggregation     |     hollow triangle: interface implementation</FONT>>];
{rank=sink; legend;}
Main -> legend [style=invis];
MainFrame -> legend [style=invis];
AppController -> legend [style=invis];
LoginPage -> legend [style=invis];
LoginService -> legend [style=invis];
MapSelectionPage -> legend [style=invis];
MapCatalogService -> legend [style=invis];
GamePage -> legend [style=invis];
GameFacade -> legend [style=invis];
RoomPanel -> legend [style=invis];
InventoryPanel -> legend [style=invis];
CluePanel -> legend [style=invis];
AnswerInputPanel -> legend [style=invis];
ResultPanel -> legend [style=invis];
}