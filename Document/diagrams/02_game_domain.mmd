classDiagram
    class GameFacade {
        -GameSession session
        -GameSetup setup
        +submit(objectId, answer) SubmitResult
        +selectItem(itemId) GameView
        +useKey(nowNanos) EscapeResult
    }
    class GameSession {
        -long userId
        -long mapId
        -GameStage stage
        -ItemId selectedItem
        -long startedAtNanos
        -Long clearedSeconds
        +inventory() List~ItemId~
        +select(itemId)
        +unlockDrawer()
        +unlockSafe()
        +escape(nowNanos)
    }
    class Puzzle {
        -long puzzleId
        -long mapId
        -int stepNo
        -String code
        -AnswerType answerType
        -String answer
        -String hint
        +check(rawAnswer) AnswerCheck
    }
    class GameSetup {
        +map() GameMap
        +puzzles() List~Puzzle~
    }
    class GameMap {
        +getMapId() int
        +isPlayable() boolean
        +getHintLimit() int
    }
    class GameView {
        +stage() GameStage
        +items() List~ItemView~
        +selectedItem() ItemId
        +elapsedSeconds() long
    }
    class ItemView {
        +id() ItemId
        +title() String
        +content() String
        +hint() String
    }
    class GameStage {
        <<enumeration>>
        START
        DRAWER_OPEN
        SAFE_OPEN
        ESCAPED
    }
    class ItemId {
        <<enumeration>>
        NOTE1
        NOTE2
        KEY
    }
    class ClearRecord {
        +getUserId() long
        +getMapId() long
        +getBestSeconds() long
    }
    GameFacade *-- GameSession
    GameFacade --> GameSetup
    GameSetup --> Puzzle
    GameSession --> GameStage
    GameSession --> ItemId
    GameFacade ..> Puzzle : validates answer
    GameFacade ..> GameView : returns snapshot
    GameView o-- ItemView
    GameFacade ..> ClearRecord : creates on escape
    GameSetup --> GameMap
