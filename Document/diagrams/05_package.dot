digraph PackageDiagram {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.32, ranksep=0.7, splines=ortho, fontname="Helvetica", fontsize=21, labelloc=t, label="CODE ROOM | Package diagram (planned dependencies)\n"];
  node [shape=box, style="rounded,filled", color="#8290a5", fillcolor="white", fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#627086", arrowsize=0.7, penwidth=1.2];

  subgraph cluster_app {
    label="app"; color="#aec3e1"; style="rounded,filled"; fillcolor="#edf3fb";
    app [label="coderoom.app\nMain · MainFrame · AppController"];
  }
  subgraph cluster_pages {
    label="pages"; color="#a7d4ca"; style="rounded,filled"; fillcolor="#ebf7f4";
    login [label="pages.login\nLoginPage"];
    mapselect [label="pages.mapselect\nMapSelectionPage"];
    gamepage [label="pages.game\nGamePage"];
  }
  subgraph cluster_widgets {
    label="widgets"; color="#e3c998"; style="rounded,filled"; fillcolor="#fff8ea";
    room [label="widgets.room\nRoomPanel"];
    clue [label="widgets.clue\nCluePanel"];
    inventory [label="widgets.inventory\nInventoryPanel"];
    result [label="widgets.result\nResultPanel"];
  }
  subgraph cluster_features {
    label="features"; color="#c4b2e2"; style="rounded,filled"; fillcolor="#f5f0fb";
    auth [label="features.auth\nLoginService"];
    catalog [label="features.mapcatalog\nMapCatalogService"];
    gameplay [label="features.gameplay\nGameFacade · game DTOs"];
    answerui [label="features.gameplay.ui\nAnswerInputPanel"];
  }
  subgraph cluster_entities {
    label="entities"; color="#b9c4d0"; style="rounded,filled"; fillcolor="#f2f5f8";
    user [label="entities.user\nUserAccount · UserRepository · JDBC"];
    map [label="entities.map\nGameMap · MapRepository · JDBC"];
    puzzle [label="entities.puzzle\nPuzzle · PuzzleRepository · JDBC"];
    session [label="entities.game\nGameSession · GameStage"];
    record [label="entities.record\nClearRecord · Repository · JDBC"];
  }
  subgraph cluster_shared {
    label="shared"; color="#c6cbd3"; style="rounded,filled"; fillcolor="#f6f7f9";
    db [label="shared.db\nDatabase · StorageException"];
  }

  app -> {login mapselect gamepage};
  login -> auth;
  mapselect -> catalog;
  gamepage -> {room clue inventory result answerui gameplay};
  auth -> user;
  catalog -> {map record};
  gameplay -> {session puzzle record};
  answerui -> gameplay;
  {user map puzzle record} -> db;

  legend [shape=plaintext, label="Arrow = intended package reference  |  JDBC implementations live in their entity package  |  FSD direction: app → pages → widgets/features → entities → shared", fontsize=10, fontcolor="#536075"];
  db -> legend [style=invis];
}
