classDiagram
    class Main
    class MainFrame
    class AppController
    class Host {
        <<interface>>
        +setPage(name, page)
        +showPage(name)
    }
    class Screens {
        <<interface>>
        +login(onLogin)
        +dashboard(user, openMaps, logout)
        +maps(user, openMap, dashboard)
        +game(user, mapId, back, restart)
    }
    class AppScreens
    class DashboardPage
    class DashboardRecordDialog
    class DashboardRecords
    class LoginPage
    class LoginService
    class MapSelectionPage
    class MapCatalogService
    class GamePage {
        +load(user, mapId)
        +inspect(object)
        +submit(object, answer)
        +selectItem(item)
        +useKey()
        +retrySave()
        +disposeGame()
    }
    class GamePort {
        <<interface>>
    }
    class Widgets {
        <<interface>>
    }
    class GameAdapter
    class GameWidgets
    class GameFacade
    class RoomPanel
    class InventoryPanel
    class CluePanel
    class AnswerInputPanel
    class ResultPanel

    Main ..> MainFrame : creates
    Main ..> AppController : creates
    Main ..> AppScreens : wires services
    MainFrame ..|> Host
    AppScreens ..|> Screens
    AppController --> Host
    AppController --> Screens
    AppController --> GamePage : lifecycle
    AppScreens ..> DashboardPage : creates
    AppScreens ..> LoginPage : creates
    AppScreens ..> MapSelectionPage : creates
    AppScreens ..> GamePage : creates
    AppScreens ..> GameAdapter : nested adapter
    AppScreens ..> GameWidgets : nested adapter
    DashboardPage ..> DashboardRecordDialog : opens
    DashboardRecordDialog --> DashboardRecords
    LoginPage --> LoginService
    MapSelectionPage --> MapCatalogService
    GamePage --> GamePort
    GamePage --> Widgets
    GameAdapter ..|> GamePort
    GameAdapter --> GameFacade
    GameWidgets ..|> Widgets
    GameWidgets *-- RoomPanel
    GameWidgets *-- InventoryPanel
    GameWidgets *-- CluePanel
    GameWidgets *-- AnswerInputPanel
    GameWidgets *-- ResultPanel
